# Memaix — hemligheter. Kopiera till .env och fyll i. Checka ALDRIG in .env.

# --- Cloudflare tunnel ---
# Tunnel-token ligger inte här utan i cloudflared-secrets/tunnel.token (chmod 600):
#   cloudflared tunnel token <tunnel-id> > cloudflared-secrets/tunnel.token

# --- Hydra OAuth-server ---
HYDRA_DB_PASSWORD=                   # generera: openssl rand -hex 32
HYDRA_SYSTEM_SECRET=                 # generera: openssl rand -hex 32
HYDRA_PUBLIC_URL=https://mcp.example.com
HYDRA_LOGIN_URL=https://mcp.example.com/login
HYDRA_CONSENT_URL=https://mcp.example.com/consent

# --- Memaix gateway ---
TOKEN_MASTER_KEY=                    # generera: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_MASTER_KEY är OBLIGATORISK i HTTP-läge (annars startar inte gatewayen).
# Sätt MEMAIX_ALLOW_EPHEMERAL_KEY=1 endast för utveckling om du accepterar att
# alla länkade konton tappas vid omstart.
# MEMAIX_ALLOW_EPHEMERAL_KEY=

# Delat tillstånd (krävs bara vid fler än en worker/process):
# MEMAIX_RATELIMIT_BACKEND=sqlite    # memory (default) | sqlite
MEMAIX_RATELIMIT_DB=/data/memaix-ratelimit.db
MEMAIX_STATE_DB=/data/memaix-state.db

# sqlite-state som annars defaultar till /tmp inne i containern och
# försvinner vid varje `docker compose up` recreate. docker-compose.yml
# bind-mountar ./data:/data — peka dessa dit för att överleva recreates.
MEMAIX_NOTIFY_DB=/data/memaix-notify.db
MEMAIX_AUDIT_DB=/data/memaix-audit.db
MEMAIX_OUTBOX_DB=/data/memaix-outbox.db
MEMAIX_ACTIONS_DB=/data/memaix-actions.db
MEMAIX_INDEX_DB=/data/memaix-index.db
MEMAIX_TOKEN_DB=/data/memaix-tokens.db
MEMAIX_RULES_DB=/data/memaix-rules.db
MEMAIX_PM_DB=/data/memaix-pm.db
MEMAIX_IDEMPOTENCY_DB=/data/memaix-idempotency.db
MEMAIX_NUDGE_DB=/data/memaix-nudge.db
MEMAIX_CHAT_DB=/data/memaix-chat.db
MEMAIX_NOTES_LINK_DB=/data/memaix-notes-link.db
MEMAIX_CONSENT_DB=/data/memaix-consent.db

# --- Login-app ---
MEMAIX_ALLOWED_USERS=jimmy
MEMAIX_LOGIN_PASSWORD_HASH=          # generera med scripts/gen-password-hash.py

# --- Backend-credentials (per projekt; referras från config/acl.yaml via *_ref) ---
# Exempel: PM_QRONKBOTS_IMAP_PASSWORD=
# NEXTCLOUD_APP_PASSWORD=

# --- Nextcloud (valfritt) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=            # generera: openssl rand -hex 16
NEXTCLOUD_PUBLIC_HOST=
